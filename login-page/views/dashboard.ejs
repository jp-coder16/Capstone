<!DOCTYPE html>
<html>
<head>
    <title>AQI Prediction System</title>

    <style>
        :root {
          font-family: system-ui, Avenir, Helvetica, Arial, sans-serif;
          line-height: 1.5;
          font-weight: 400;
          color: rgba(255, 255, 255, 0.87);
        }

        /* ✅ Background Image Applied */
        body {
          margin: 0;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
          justify-content: space-between;

          background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
                      url('bg.jpg') no-repeat center center fixed;

          background-size: cover;
        }

        .container {
          text-align: center;
          padding: 3rem 2rem;
        }

        h1 {
          font-size: 3rem;
          margin-bottom: 10px;
        }

        .subtitle {
          color: #ddd;
          margin-bottom: 30px;
        }

        .button-group {
          margin-bottom: 40px;
        }

        .btn {
          padding: 10px 20px;
          background-color: #646cff;
          color: white;
          text-decoration: none;
          border-radius: 8px;
          margin: 0 10px;
          transition: 0.3s;
        }

        .btn:hover {
          background-color: #535bf2;
        }

        .btn-outline {
          padding: 10px 20px;
          border: 1px solid #646cff;
          color: #646cff;
          text-decoration: none;
          border-radius: 8px;
          margin: 0 10px;
          transition: 0.3s;
        }

        .btn-outline:hover {
          background-color: #646cff;
          color: white;
        }

        .card-grid {
          display: flex;
          justify-content: center;
          gap: 25px;
          flex-wrap: wrap;
        }

        .card {
          background-color: rgba(26, 26, 26, 0.85);
          padding: 2rem;
          border-radius: 12px;
          width: 280px;
          transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
          transform: translateY(-8px);
          box-shadow: 0 0 20px #646cff66;
        }

        footer {
          text-align: center;
          padding: 1rem;
          background-color: rgba(26, 26, 26, 0.85);
          color: #ccc;
        }
    </style>

</head>
<body>

<div class="container">

    <h1>AQI Prediction System</h1>
    <p class="subtitle">Smart Air Quality Monitoring & Forecasting Platform</p>

    <div class="card-grid">

        <div class="card">
            <h3>Real-time AQI Data</h3>
            <p>Monitor live air quality index values for your city.</p>
        </div>

        <div class="card">
            <h3>Predictive Analytics</h3>
            <p>Forecast AQI levels using smart prediction models.</p>
        </div>

        <div class="card">
            <h3>Health Insights</h3>
            <p>Understand air pollution impact on health categories.</p>
        </div>

    </div>

</div>

<footer>
    © 2026 AQI Prediction System | Capstone Project
</footer>

</body>
</html>